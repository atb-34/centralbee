# -----------------------------------------------------------------------------
# CentralBee — ortam değişkenleri
#
# Bu dosyayı `.env.local` adıyla kopyalayın ve Supabase projenizden aldığınız
# değerleri yapıştırın. `.env.local` git'e gönderilmez.
# -----------------------------------------------------------------------------

# Supabase → Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Supabase → Project Settings → API Keys → anon / publishable
# Tarayıcıya gider. Gizli değildir; koruma RLS ile sağlanır.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase → Project Settings → API Keys → service_role / secret
# GİZLİDİR. Yalnızca sunucuda kullanılır, tarayıcıya asla gönderilmez.
# Bu anahtar RLS'i tamamen atlar — kimseyle paylaşmayın.
SUPABASE_SERVICE_ROLE_KEY=

# Kullanıcı adlarının eşlendiği teknik e-posta alan adı.
# Bu adrese posta gitmez, alan adının gerçekten var olması gerekmez.
# Değiştirirseniz mevcut kullanıcılar giriş yapamaz.
AUTH_EMAIL_DOMAIN=users.centralbee.app
